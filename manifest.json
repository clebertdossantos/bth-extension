{
  "manifest_version": 3,
  "name": "BTH Extension",
  "version": "1.0",
  "description": "Extensão para auxiliar no desenvolvimento Betha",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
